{
  "name": "mintymc-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "build:pages": "BASE=/Minty-MC/ vite build && cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "deploy:pages": "npm run build:pages && gh-pages -d dist -b gh-pages --dotfiles"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@react-three/fiber": "^8.18.0",
    "framer-motion": "^14.14.0",
    "lenis": "^1.3.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "gh-pages": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
